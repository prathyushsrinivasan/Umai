# Copy to .env. Keep secrets out of source control.
POSTGRES_DB=umai
POSTGRES_USER=umai
POSTGRES_PASSWORD=change-me-locally
DB_PORT=5432
BACKEND_PORT=8080
SPRING_PROFILES_ACTIVE=prod
CORS_ALLOWED_ORIGINS=http://localhost:5173
LOG_LEVEL=INFO

# Production defaults exclude fictional samples, including samples left in old databases.
# For an explicit sample-data development environment use SPRING_PROFILES_ACTIVE=dev
# and FLYWAY_LOCATIONS=classpath:db/migration,classpath:db/seed.
FLYWAY_LOCATIONS=classpath:db/migration
SUBMISSIONS_AUTO_PUBLISH=false
UMAI_ADMIN_EMAILS=

# Required: generate a private signing key (openssl rand -base64 48).
JWT_SECRET=
JWT_EXPIRES_IN=12h

# Tokyo OSM coverage: bootstrap empty/stale databases, then refresh Mondays 04:00 JST.
# A 4x4 grid is subdivided when upstream results hit their limit.
# Each run is bounded, records partial coverage, and retains data on source outages.
UMAI_REFRESH_ENABLED=true
UMAI_REFRESH_MAX_REQUESTS=64

# Optional Google identifier matching and user-requested photos.
# No descriptive Google content is copied into restaurant records.
GOOGLE_MAPS_API_KEY=
UMAI_GOOGLE_ENRICH_ON_START=false
GOOGLE_PHOTOS_ENABLED=true
# All outgoing Google calls (including failed attempts and free metadata) count.
# Persistent daily/monthly ceilings are shared across replicas. Zero disables calls.
GOOGLE_DAILY_REQUESTS=100
GOOGLE_MONTHLY_REQUESTS=1000

RATE_LIMIT_ENABLED=true
RATE_LIMIT_AUTH_ATTEMPTS=10
RATE_LIMIT_WRITE_REQUESTS=60
RATE_LIMIT_PHOTO_REQUESTS=10
RATE_LIMIT_PERIOD=1m
