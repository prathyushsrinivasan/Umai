# Export these variables when running the backend outside Compose.
# Spring does not load this file automatically.
DB_URL=jdbc:postgresql://localhost:5432/umai
DB_USERNAME=umai
DB_PASSWORD=
JWT_SECRET=
SPRING_PROFILES_ACTIVE=prod
FLYWAY_LOCATIONS=classpath:db/migration
SUBMISSIONS_AUTO_PUBLISH=false
UMAI_REFRESH_ENABLED=true
UMAI_REFRESH_MAX_REQUESTS=64
GOOGLE_MAPS_API_KEY=
GOOGLE_DAILY_REQUESTS=100
GOOGLE_MONTHLY_REQUESTS=1000
GOOGLE_PHOTOS_ENABLED=true
